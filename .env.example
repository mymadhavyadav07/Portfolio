# Copy this file to `.env.local` and set your own values.
# NEXT_PUBLIC_ vars are exposed to the browser and inlined at build time,
# so restart `npm run dev` (or rebuild) after changing them.

# Résumé link — the "Résumé" / "Download résumé" buttons open this URL.
# Use a Google Drive share link (Share → Anyone with the link → Copy link):
#   View in Drive:     https://drive.google.com/file/d/FILE_ID/view?usp=sharing
#   Force download:    https://drive.google.com/uc?export=download&id=FILE_ID
NEXT_PUBLIC_RESUME_URL=https://drive.google.com/file/d/FILE_ID/view?usp=sharing
